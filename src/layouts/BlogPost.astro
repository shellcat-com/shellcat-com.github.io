---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE } from '../consts';

interface Adjacent { href: string; title: string; }
interface Props {
  post: CollectionEntry<'blog'>;
  readingTime: string;
  newer: Adjacent | null;
  older: Adjacent | null;
}
const { post, readingTime, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags } = post.data;
---
<BaseLayout title={title} description={description} image={heroImage} article={true}>
  <article class="article-main" style="max-width:var(--measure);margin-inline:auto;">
    <header class="article-header">
      <a class="back" href="/">← all writing</a>
      <h1>{title}</h1>
      <div class="meta">
        <FormattedDate date={pubDate} />
        <span>·</span>
        <span>{readingTime}</span>
        {tags && tags.length > 0 && <span>·</span>}
        {tags?.map((t) => <span class="tag">{t}</span>)}
        {updatedDate && <span>· updated <FormattedDate date={updatedDate} /></span>}
      </div>
      {heroImage && (
        <div class="article-hero">
          <img src={heroImage} alt="" width="720" height="405" />
        </div>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    {(newer || older) && (
      <nav class="post-nav">
        {newer ? (
          <a href={newer.href}><span class="dir">← newer</span><div class="t">{newer.title}</div></a>
        ) : <span></span>}
        {older ? (
          <a class="next" href={older.href}><span class="dir">older →</span><div class="t">{older.title}</div></a>
        ) : <span></span>}
      </nav>
    )}

    <div class="author-card">
      <img src="/avatar.png" alt="" width="44" height="44" />
      <div>
        <div class="name">{SITE.title} {SITE.handle}</div>
        <div class="bio">Security researcher. PC or GTFO.</div>
      </div>
    </div>
  </article>
</BaseLayout>
