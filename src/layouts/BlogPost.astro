---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE } from '../consts';

interface TocItem { depth: number; slug: string; text: string; }
interface Adjacent { href: string; title: string; }
interface Props {
  post: CollectionEntry<'blog'>;
  readingTime: string;
  toc: TocItem[];
  newer: Adjacent | null;
  older: Adjacent | null;
}
const { post, readingTime, toc, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags } = post.data;
---
<BaseLayout title={title} description={description} image={heroImage} article={true} wide={true}>
  <div class="article-shell">
    <article class="article-main">
      <header class="article-header">
        <a class="back" href="/">← all writing</a>
        <h1>{title}</h1>
        <div class="meta">
          <FormattedDate date={pubDate} />
          <span>·</span>
          <span>{readingTime}</span>
          {tags && tags.length > 0 && <span>·</span>}
          {tags?.map((t) => <span class="tag">{t}</span>)}
          {updatedDate && <span>· updated <FormattedDate date={updatedDate} /></span>}
        </div>
        {heroImage && (
          <div class="article-hero">
            <img src={heroImage} alt="" width="720" height="405" />
          </div>
        )}
      </header>

      <div class="prose">
        <slot />
      </div>

      {(newer || older) && (
        <nav class="post-nav">
          {newer ? (
            <a href={newer.href}><span class="dir">← newer</span><div class="t">{newer.title}</div></a>
          ) : <span></span>}
          {older ? (
            <a class="next" href={older.href}><span class="dir">older →</span><div class="t">{older.title}</div></a>
          ) : <span></span>}
        </nav>
      )}

      <div class="author-card">
        <img src="/avatar.png" alt="" width="56" height="56" />
        <div>
          <div class="name">{SITE.title} <span style="color:var(--accent)">{SITE.handle}</span></div>
          <div class="bio">Independent security researcher. Write-ups only ship with a working PoC and a fixed target.</div>
        </div>
      </div>
    </article>

    {toc.length > 1 && (
      <aside class="toc">
        <p class="toc__label">on this page</p>
        <ul>
          {toc.map((h) => (
            <li><a href={`#${h.slug}`} style={h.depth === 3 ? 'padding-left:30px;font-size:12.5px' : undefined}>{h.text}</a></li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</BaseLayout>
