---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Share from '../components/Share.astro';
import { SITE } from '../consts';

interface Adjacent { href: string; title: string; }
interface Props {
  post: CollectionEntry<'blog'>;
  readingTime: string;
  newer: Adjacent | null;
  older: Adjacent | null;
}
const { post, readingTime, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const postUrl = new URL(`/blog/${post.id}/`, SITE.url).href;
---
<BaseLayout title={title} description={description} article={true}>
  <article style="max-width:var(--wrap);margin-inline:auto;">
    <header class="article-header">
      <a class="back" href="/">← all writing</a>
      <h1>{title}</h1>
      <div class="article-meta">
        <FormattedDate date={pubDate} />
        <span>· {readingTime}</span>
        {tags && tags.length > 0 && tags.map((t) => <span class="tag">{t}</span>)}
        {updatedDate && <span>· updated <FormattedDate date={updatedDate} /></span>}
      </div>
    </header>

    <div class="prose">
      <slot />
    </div>

    {(newer || older) && (
      <nav class="post-nav">
        {newer ? (
          <a class="prev" href={newer.href}>
            <div class="nav-arrow">← newer</div>
            <div class="post-nav-title">{newer.title}</div>
          </a>
        ) : <span></span>}
        {older ? (
          <a class="next" href={older.href}>
            <div class="nav-arrow">older →</div>
            <div class="post-nav-title">{older.title}</div>
          </a>
        ) : <span></span>}
      </nav>
    )}

    <Share url={postUrl} title={title} />

    <div class="author-card">
      <img src="/avatar.png" alt="" width="44" height="44" />
      <div>
        <div class="name">{SITE.title} {SITE.handle}</div>
        <div class="bio">Security researcher. PC or GTFO.</div>
      </div>
    </div>
  </article>
</BaseLayout>
