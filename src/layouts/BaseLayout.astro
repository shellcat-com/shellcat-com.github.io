---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  wide?: boolean;
}
const { wide, ...head } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...head} />
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main class="site-main">
      <div class:list={['wrap', { narrow: !wide }]}>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
