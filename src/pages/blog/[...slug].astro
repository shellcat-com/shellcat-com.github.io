---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { byNewest, readingTime } from '../../utils';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(byNewest);
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: posts[i - 1] ?? null, // more recent
      older: posts[i + 1] ?? null, // less recent
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<BlogPost
  post={post}
  readingTime={readingTime(post.body)}
  toc={toc}
  newer={newer ? { href: `/blog/${newer.id}/`, title: newer.data.title } : null}
  older={older ? { href: `/blog/${older.id}/`, title: older.data.title } : null}
>
  <Content />
</BlogPost>
