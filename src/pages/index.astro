---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE } from '../consts';
import { byNewest } from '../utils';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(byNewest);
---
<BaseLayout>
  <section class="author">
    <img class="author-avatar" src="/avatar.png" alt="" width="70" height="70" />
    <h2 class="author-name">{SITE.title}</h2>
    <p class="author-bio">{SITE.tagline}. Proof of concept, or it didn't happen.</p>
  </section>

  <h3 class="posts-note">Recent Posts</h3>

  {posts.length === 0 ? (
    <p class="empty-state">No write-ups yet.</p>
  ) : (
    posts.map((post) => (
      <article class="post-item">
        <h4 class="post-item-title">
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        </h4>
        <time class="post-item-date" datetime={post.data.pubDate.toISOString()}>
          <FormattedDate date={post.data.pubDate} />
        </time>
      </article>
    ))
  )}
</BaseLayout>
