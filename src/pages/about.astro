---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const focus = ['auth bypass', 'SSRF', 'IDOR / BOLA', 'OAuth / SSO', 'business logic', 'cloud misconfig'];
const findings = [
  { sev: 'High', text: 'Open redirect chained to OAuth token leak → one-click account takeover.' },
  { sev: 'High', text: 'PDF-export SSRF read cloud metadata + temporary IAM credentials.' },
  { sev: 'High', text: 'IDOR in an invoice API exposing PII across ~40k customer records.' },
];
---
<BaseLayout title="about" description={`About ${SITE.title}`}>
  <section class="about-hero">
    <div class="frame">
      <img src="/avatar.png" alt={`${SITE.title} mascot`} width="140" height="140" />
    </div>
    <div>
      <h1>{SITE.title}</h1>
      <span class="handle">{SITE.handle} · bug bounty hunter</span>
      <div class="status"><span class="dot"></span> available for private programs &amp; collabs</div>
    </div>
  </section>

  <div class="prose">
    <p>
      Independent security researcher. I break web apps, cloud infrastructure, and
      APIs for a living — then write up what actually worked. The bugs that make it
      here are the ones where reasoning beat tooling: a couple of "informational"
      quirks stacked into something a program genuinely paid for.
    </p>

    <h2>Focus areas</h2>
    <div class="focus-grid">
      {focus.map((f) => <span class="chip">{f}</span>)}
    </div>
    <p>
      Everything is from authorized testing on programs where I had explicit
      permission. I don't publish theory, and I don't name unfixed targets.
    </p>

    <h2>Selected findings</h2>
    <ul>
      {findings.map((f) => (
        <li><span class="tag tag--high" style="margin-right:8px">{f.sev}</span>{f.text}</li>
      ))}
    </ul>

    <h2>How I work</h2>
    <blockquote>PC or GTFO. Proof of concept, or it doesn't exist.</blockquote>
    <p>
      No proof of concept, no post. If it's here, it was reported, triaged, and
      resolved first — with reproducible steps and measured impact, not a wish-list
      severity.
    </p>

    <h2>Contact</h2>
    <p>
      Reach me through the links in the header. For anything sensitive, use an
      encrypted channel and I'll share a key.
    </p>
  </div>
</BaseLayout>
