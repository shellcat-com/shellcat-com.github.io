---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---
<BaseLayout title="about" description={`About ${SITE.title}`}>
  <div class="about-shell">
    <div class="who">
      <img src="/avatar.png" alt="" width="48" height="48" />
      <div>
        <h1>{SITE.title}</h1>
        <span class="handle">{SITE.handle} · bug bounty hunter</span>
      </div>
    </div>

    <p>
      Independent security researcher. I break web apps, cloud infrastructure, and
      APIs — then write up what worked. Only findings with a working PoC make it here.
    </p>

    <h2>Contact</h2>
    <p>
      Reach me through the links in the header. For anything sensitive, use an
      encrypted channel.
    </p>
  </div>
</BaseLayout>
