---
import FormattedDate from './FormattedDate.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  heroImage?: string;
  tags?: string[];
  readingTime?: string;
  index?: number;
}
const { href, title, description, pubDate, tags = [], readingTime, index = 0 } = Astro.props;

const tagClass = (t: string) => {
  const l = t.toLowerCase();
  if (['critical', 'rce', 'ato'].includes(l)) return 'tag tag--crit';
  if (['high', 'ssrf', 'idor', 'sqli'].includes(l)) return 'tag tag--high';
  return 'tag';
};
const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---
<li data-tags={tags.map(slug).join(',')}>
  <a class="post-row" href={href}>
    <div class="post-row__main">
      <div class="post-row__title">{title}</div>
      <p class="post-row__desc">{description}</p>
    </div>
    <div class="post-row__meta">
      <FormattedDate date={pubDate} />
      {readingTime && <span> · {readingTime}</span>}
      {tags.length > 0 && (
        <div class="post-row__tags">
          {tags.slice(0, 2).map((t) => <span class={tagClass(t)}>{t}</span>)}
        </div>
      )}
    </div>
  </a>
</li>
