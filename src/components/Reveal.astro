---
// Reusable scroll-reveal wrapper. Animates its children in when they enter
// the viewport (see initReveal in BaseLayout). Respects prefers-reduced-motion.
//
//   <Reveal>…</Reveal>                     fade-up (default)
//   <Reveal dir="left" delay={120}>…</Reveal>
//   <Reveal as="li" dir="scale">…</Reveal>
interface Props {
  /** stagger delay in ms */
  delay?: number;
  /** entry direction */
  dir?: 'up' | 'left' | 'right' | 'scale';
  /** element tag to render */
  as?: string;
  class?: string;
}
const { delay = 0, dir = 'up', as = 'div', class: cls = '', ...rest } = Astro.props;
const Wrapper = as;
---
<Wrapper
  class:list={['reveal', cls]}
  data-dir={dir === 'up' ? undefined : dir}
  style={delay ? `--reveal-delay:${delay}ms` : undefined}
  {...rest}
>
  <slot />
</Wrapper>
